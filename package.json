{
  "name": "textpilot",
  "version": "0.0.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun ./node_modules/vite/bin/vite.js",
    "check": "bun ./node_modules/svelte-check/bin/svelte-check --tsconfig ./tsconfig.json",
    "build": "bun run check && bun ./node_modules/vite/bin/vite.js build",
    "app:dev": "bun ./node_modules/@tauri-apps/cli/tauri.js dev",
    "app:build": "bun ./node_modules/@tauri-apps/cli/tauri.js build --bundles nsis",
    "app:portable": "bun ./node_modules/@tauri-apps/cli/tauri.js build --no-bundle",
    "preview": "bun ./node_modules/vite/bin/vite.js preview",
    "tauri": "bun ./node_modules/@tauri-apps/cli/tauri.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-updater": "^2",
    "svelte": "^5.56.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^25.9.2",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
