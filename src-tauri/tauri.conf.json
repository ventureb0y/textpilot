{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TextPilot",
  "version": "0.0.4",
  "identifier": "dev.textpilot.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TextPilot",
        "width": 1100,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "TextPilot",
    "category": "Productivity",
    "shortDescription": "Local snippets, autocomplete, and autocorrection",
    "longDescription": "TextPilot is a local Windows utility for managing snippets, autocomplete suggestions, and autocorrection profiles.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ]
      }
    }
  }
}
